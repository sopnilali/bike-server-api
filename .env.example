# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Postgres — Neon database connection (direct, used by Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
# Pooled connection (use for serverless / high-concurrency runtime if needed)
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&channel_binding=require"

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3="https://YOUR-ENDPOINT.storage.c-4.ap-southeast-1.aws.neon.tech"
AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_KEY"
AWS_REGION="ap-southeast-1"
S3_BUCKET="uploads"
